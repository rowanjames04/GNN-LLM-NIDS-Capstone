# --- Agent / local context (contains absolute machine paths) ---
CLAUDE.md
.claude/

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- Data ---
# The full dataset never enters git: GitHub hard-rejects files over 100 MB, and
# git keeps every version of a binary forever. Fetched by download_data.py and
# pinned by checksum instead -- see configs/dataset.yaml.
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# Fitted transform parameters and split boundaries are small and are provenance:
# they pin the exact preprocessing that produced every committed result. The
# feature arrays they generate stay out (33 MB, and regenerable from these).
!data/processed/pipeline.json
!data/processed/splits.json
!data/processed/attack_families.json

# data/sample/ is deliberately NOT ignored. It holds a small stratified sample
# (scripts/make_sample.py) so tests run against real data and the repo can be
# cloned and run without a 1 GB download.

# --- Results: keep metrics + figures, ignore heavy artefacts ---
results/checkpoints/*
!results/checkpoints/.gitkeep
*.pt
*.pth
*.ckpt
*.pkl
*.joblib

# --- Secrets ---
.env
.env.*
!.env.example
*.key
secrets/

# --- OS / editor ---
.DS_Store
.vscode/
.idea/
*.swp

# Download staging folders (Kaggle archives etc.)
archive*/

# Smoke-run outputs. Seconds of training, meaningless numbers -- they must
# never sit in results/metrics/ looking like results (the C17 failure mode).
results/metrics/**/smoke_*.json

# Smoke-run evidence packs. Same reason as smoke metrics: meaningless numbers
# must not sit where real ones live.
results/evidence/smoke_*.json

# Smoke-run generated reports.
results/reports/smoke_*.json
